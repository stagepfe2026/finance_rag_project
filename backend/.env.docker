HF_HUB_OFFLINE=1

QDRANT_HOST=qdrant
QDRANT_PORT=6333
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=finance_rag_dep
MONGODB_DOCUMENTS_COLLECTION=documents
MONGODB_USERS_COLLECTION=users
MONGODB_SESSIONS_COLLECTION=auth_sessions
MONGODB_CHAT_CONVERSATIONS_COLLECTION=chat_conversations
MONGODB_CHAT_MESSAGES_COLLECTION=chat_messages
MONGODB_RECLAMATIONS_COLLECTION=reclamations
DOCUMENTS_STORAGE_DIR=storage/documents
RECLAMATIONS_STORAGE_DIR=storage/reclamations

EMBEDDING_MODEL_NAME=mxbai-embed-large:latest
OLLAMA_BASE_URL=http://ollama:11434
GENERATION_MODEL_NAME=llama3:latest

CHUNK_SIZE=120
CHUNK_OVERLAP=20
CATEGORY_PROBE_TOP_K=2
RETRIEVAL_TOP_K_PER_CATEGORY=6
FINAL_TOP_K=4
MIN_VECTOR_SCORE=0.50
MIN_LEXICAL_SCORE=0.12
MIN_FINAL_SCORE=0.50
TEMPERATURE=0.05
TOP_P=0.3
MAX_NEW_TOKENS=1024
TOP_K=20
REPETITION_PENALTY=1.1
CONTEXT_WINDOW=4096

AUTH_SESSION_COOKIE_NAME=rag_finance_session
AUTH_CSRF_COOKIE_NAME=rag_finance_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_HOURS=8
AUTH_FRONTEND_BASE_URL=http://localhost:5173
AUTH_OIDC_ISSUER_URL=http://localhost:8080/realms/rag-finance
AUTH_OIDC_CLIENT_ID=rag-finance-web
AUTH_OIDC_CLIENT_SECRET=change-me
AUTH_OIDC_REDIRECT_URI=http://localhost/api/v1/auth/callback
AUTH_OIDC_SCOPE=openid profile email
AUTH_SEED_DEFAULT_USERS=false
