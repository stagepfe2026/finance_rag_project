@startuml notification

title Envoi des notifications aux utilisateurs

skinparam sequenceArrowThickness 1.5
skinparam sequenceGroupBorderThickness 1.5
skinparam backgroundColor #ffffff
skinparam sequenceGroupBodyBackgroundColor transparent

control "DocumentIndexService" as IndexService #LightYellow
control "NotificationService" as NotifService #LightYellow
entity "UsersRepository" as UserRepo #DarkSeaGreen
entity "DocumentFavoriteRepository" as FavRepo #DarkSeaGreen
entity "NotificationRepository" as NotifRepo #DarkSeaGreen
entity "NotificationConnectionManager" as WsManager #DarkSeaGreen

IndexService -> NotifService : alert_document_ready(stored_document)
note right : notifie tous les utilisateurs Finance\nqu'un nouveau document est disponible

NotifService -> UserRepo : list_by_roles(["FINANCE_USER"])
note right : récupère tous les utilisateurs\nautorisés à consulter les documents
UserRepo --> NotifService : users[]

loop pour chaque utilisateur Finance
    NotifService -> NotifService : crée NotificationModel(\ntype="document_indexed")
end

NotifService -> NotifRepo : create(notifications[])
note right : persistées en base\npour être consultables plus tard
NotifRepo --> NotifService : notifications créées[]

loop pour chaque notification créée
    NotifService -> WsManager : broadcast_to_user(user_id, payload)
    note right : envoyée uniquement si\nl'utilisateur est connecté
    WsManager --> NotifService : ok
end

NotifService --> IndexService : ok

opt le document remplace un document existant
    IndexService -> NotifService : notify_document_deprecated_for_favorites(\ndeprecated_doc, new_document_title)
    note right : avertit les utilisateurs qui avaient\nmis l'ancien document en favori

    NotifService -> FavRepo : get_user_ids_for_document(deprecated_doc.id)
    note right : identifie les utilisateurs\nqui avaient ce document en favori
    FavRepo --> NotifService : favorite_user_ids[]

    alt aucun utilisateur n'a ce document en favori
        NotifService --> IndexService : return
    end

    loop pour chaque utilisateur concerné
        NotifService -> NotifService : crée NotificationModel(\ntype="document_deprecated")
    end

    NotifService -> NotifRepo : create(notifications[])
    NotifRepo --> NotifService : notifications créées[]

    loop pour chaque notification créée
        NotifService -> WsManager : broadcast_to_user(user_id, payload)
        WsManager --> NotifService : ok
    end

    NotifService --> IndexService : ok
end

@enduml
