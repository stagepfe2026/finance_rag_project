@startuml legal_metadata

title Construction des métadonnées légales et vérification doublon

skinparam sequenceArrowThickness 1.5
skinparam sequenceGroupBorderThickness 1.5
skinparam backgroundColor #ffffff
skinparam sequenceGroupBodyBackgroundColor transparent

control "DocumentIndexService" as IndexService #LightYellow
control "LegalMetadataService" as MetaService #LightYellow
control "LegalStatusService" as StatusService #LightYellow
entity "DocumentRepository" as DocRepo #DarkSeaGreen

IndexService -> MetaService : build_legal_metadata(\ndocument_type, date_publication,\ndate_entree_vigueur, version,\nrelation_type, related_document_id)

MetaService -> MetaService : _validate_relation_type(relation_type)
note right : vérifie que la valeur appartient\naux types de relation autorisés
MetaService -> MetaService : _validate_document_type(document_type)
note right : vérifie que le type appartient\naux types de document autorisés

MetaService -> MetaService : vérifie la cohérence de la relation
note right : si une relation est définie,\nle document cible est obligatoire
alt relation définie sans document cible
    MetaService --> IndexService : 400 Bad Request
end

opt un document cible est renseigné
    MetaService -> DocRepo : get_by_id(related_document_id)
    note right : le document cible doit exister\net ne pas être supprimé
    DocRepo --> MetaService : document cible | introuvable
    alt document cible introuvable ou supprimé
        MetaService --> IndexService : 400 Bad Request
    end
end

MetaService -> MetaService : vérifie la cohérence des dates
note right : la date d'entrée en vigueur\ndoit être après la date de publication
alt dates incohérentes
    MetaService --> IndexService : 400 Bad Request
end

MetaService -> StatusService : infer_status_from_date(date_entree_vigueur)
note right : si la date d'entrée en vigueur\nest dans le futur → statut "futur"\nsinon → statut "actif"
StatusService --> MetaService : "futur" | "actif"

MetaService --> IndexService : métadonnées légales complètes

@enduml
