@startuml DA_ask_chat

title Diagramme d'activité — Poser une question

skinparam activityArrowThickness 1.5
skinparam activityBackgroundColor #FEFEFE
skinparam activityBorderColor #888888
skinparam swimlaneBorderThickness 1.5
skinparam backgroundColor #ffffff

|Utilisateur|
start
:Saisit sa question\net clique sur Envoyer;

|ChatPage (Frontend)|
:Envoie la question au serveur;

|Backend|
if (Utilisateur connecté et autorisé ?) then (non)
    :Accès refusé;
    |ChatPage (Frontend)|
    :Redirige vers la page de connexion;
    stop
else (oui)
endif

|Backend|
if (La question est vide ?) then (oui)
    :Signale une erreur;
    |ChatPage (Frontend)|
    :Affiche le message d'erreur;
    stop
else (non)
endif

|Backend|
:Crée ou récupère la conversation;
:Charge l'historique de la conversation;
:Enregistre la question de l'utilisateur;
:Réserve un emplacement pour la réponse;
note right : message vide enregistré immédiatement\npour que le frontend puisse suivre\nl'état de la génération
:Envoie la conversation et le\nmessage assistant vide au frontend;

|ChatPage (Frontend)|
:Reçoit les données initiales;

fork
    :Affiche la question\net un indicateur de chargement;

fork again
    |Backend|
    note right : Traitement en arrière-plan

    fork
        :Nettoie et prépare la question;
        :Convertit la question\nen données de recherche;
    fork again
        :Analyse le profil\nde la question;
        note right
            Mode courant    — documents en vigueur
            Mode futur      — documents à venir
            Mode comparaison — ancienne vs nouvelle version
        end note
    end fork

    :Identifie la catégorie de documents\nla plus pertinente;

    if (Des documents correspondants existent ?) then (non)
        :Prépare la réponse :\naucun document trouvé;
    else (oui)
        :Recherche les segments\nles plus pertinents dans les documents;
        if (Des segments utiles ont été trouvés ?) then (non)
            :Prépare la réponse :\naucun segment pertinent trouvé;
        else (oui)
            :Sélectionne et classe\nles meilleurs segments;
            :Prépare la question\navec le contexte documentaire;
        endif
    endif

    |Ollama (LLM)|
    if (Un contexte documentaire est disponible ?) then (oui)
        :Rédige la réponse\nen langage naturel;
    else (non)
        :Renvoie la réponse par défaut;
    endif

    |Backend|
    if (La réponse est basée\nsur les documents ?) then (non)
        :Remplace par :\naucun résultat fiable trouvé;
    else (oui)
        :Ajoute un avertissement\nsi le document n'est pas encore applicable;
    endif

    if (Une erreur s'est produite ?) then (oui)
        :Marque la réponse comme échouée;
    else (non)
        :Enregistre la réponse\net les documents sources;
    endif

end fork

|ChatPage (Frontend)|
:Vérifie si la réponse est prête;
if (La réponse est-elle prête ?) then (échouée)
    :Affiche un message d'erreur;
    stop
else (prête)
    :Affiche la réponse\navec les documents utilisés;
endif

|Utilisateur|
:Lit la réponse\net consulte les documents sources;
stop

@enduml
