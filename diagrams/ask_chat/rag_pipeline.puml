@startuml rag_pipeline

title Pipeline RAG — Recherche et génération de la réponse

skinparam sequenceArrowThickness 1.5
skinparam sequenceGroupBorderThickness 1.5
skinparam backgroundColor #ffffff
skinparam sequenceGroupBodyBackgroundColor transparent

control "ChatService" as ChatService #LightYellow
control "RagService" as RagService #LightYellow
control "NLPService" as NLP #LightYellow
control "EmbeddingService" as Embedding #LightYellow
control "LegalRankingService" as Ranking #LightYellow
control "RetrievalService" as Retrieval #LightYellow
control "RetrievalFilterService" as Filter #LightYellow
control "RerankerService" as Reranker #LightYellow
control "PromptBuilderService" as PromptBuilder #LightYellow
control "GenerationService" as Generation #LightYellow
control "DocumentContextService" as DocContext #LightYellow
entity "ChatRepository" as ChatRepo #DarkSeaGreen

ChatService -> RagService : answer(\nquestion, response_mode, query_mode)
note right : query_mode détermine quels documents inclure :\ncourant uniquement, futur, ou comparaison avec une version précédente

RagService -> NLP : preprocess_query(question)
note right : nettoie et normalise la question\nen français avant la recherche
NLP --> RagService : normalized_question

RagService -> Embedding : generate_embeddings([normalized_question])
note right : convertit la question en vecteur numérique\npour la recherche sémantique dans Qdrant
Embedding --> RagService : query_vector

RagService -> Ranking : classify_question(normalized_question)
note right : détermine le profil de la question :\nfactuel, comparatif, historique, ou autre
Ranking --> RagService : question_profile

ref over RagService, Retrieval
    Recherche et classement des segments
end ref

alt aucune base de documents disponible
    RagService --> ChatService : "Aucune base de connaissance disponible"
else aucune catégorie pertinente trouvée
    RagService --> ChatService : "Information non trouvée dans les sources"
else aucun segment dense retourné
    RagService --> ChatService : "Information non trouvée dans les sources"
else aucun segment pertinent après filtrage
    RagService --> ChatService : "Information non trouvée dans les sources"
end

RagService -> Filter : _build_final_chunks(\nmain_relevant, related_relevant,\nrelated_ranked, question_profile, query_mode)
note right : sélectionne les meilleurs segments selon le mode :\nmode courant → uniquement les documents actifs\nmode comparaison → mélange documents courants et liés
Filter --> RagService : final_chunks[]

RagService -> Reranker : rerank(normalized_question, final_chunks, top_k)
note right : reclasse les segments avec un modèle cross-encodeur\nplus précis que la simple similarité vectorielle
Reranker --> RagService : final_chunks reclassés

RagService -> PromptBuilder : format_context(final_chunks)
note right : met en forme les segments retenus\npour les intégrer dans le prompt du modèle
PromptBuilder --> RagService : context

RagService -> PromptBuilder : compose_prompt(\nquestion, context, response_mode,\nquestion_profile, query_mode)
note right : adapte la structure et le style du prompt\nselon la longueur demandée et le profil de la question
PromptBuilder --> RagService : prompt

RagService -> Generation : generate_answer(prompt)
note right : génère la réponse en langage naturel\nà partir du contexte extrait des documents
Generation --> RagService : answer

RagService -> Filter : _needs_fallback(answer, final_chunks)
note right : vérifie que la réponse est bien ancrée\ndans les documents et non générée hors contexte

alt réponse hors contexte ou non fiable
    RagService -> RagService : answer = "Information non trouvée dans les sources"
else réponse valide
    RagService -> DocContext : _ensure_future_warnings(answer, final_chunks)
    note right : ajoute un avertissement si un document cité\nn'est pas encore entré en vigueur
    DocContext --> RagService : answer enrichie
end

RagService -> DocContext : _build_document_sources(final_chunks)
note right : construit la liste dédoublonnée des documents sources\nà afficher avec la réponse, triée par score
DocContext --> RagService : sources[]

RagService --> ChatService : {question, answer, sources[]}

ChatService -> ChatRepo : update_content(\nassistant_message_id, answer,\nsources[], status="completed")
note right : met à jour le message assistant en base\navec la réponse générée et les sources associées
ChatRepo --> ChatService : ok

@enduml
