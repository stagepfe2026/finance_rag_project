@startuml reclamation_etat_transition

title Diagramme État-Transition — Réclamation

skinparam backgroundColor #ffffff
skinparam defaultFontSize 12
skinparam state {
    BackgroundColor #EEF2FF
    BorderColor     #4A6FA5
    FontColor       #1a1a2e
    FontStyle       bold
    ArrowColor      #4A6FA5
    ArrowThickness  1.5
    StartColor      #1a1a2e
    EndColor        #1a1a2e
}

[*] --> PENDING : Créer une réclamation

PENDING --> PENDING     : Modifier la réclamation
PENDING --> IN_PROGRESS : Prendre en charge la réclamation
PENDING --> DELETED     : Supprimer la réclamation

IN_PROGRESS --> RESOLVED : Répondre à la réclamation\n[première réponse uniquement]

RESOLVED --> RESOLVED : Accuser réception de la réponse

DELETED  --> [*]
RESOLVED --> [*]

note right of PENDING
  - Génération du numéro de ticket
  - Notification admin si priorité URGENT
end note

note right of IN_PROGRESS
  - Admin assigné à la réclamation
  - Date de prise en charge enregistrée
end note

note right of RESOLVED
  - Réponse de l'admin sauvegardée
  - Utilisateur notifié
  - Accusé de lecture en attente
end note

note right of DELETED
  - Suppression logique
  - Date de suppression enregistrée
end note

@enduml
