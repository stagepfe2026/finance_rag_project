@startuml Diagramme_de_Classes_Reel

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBackgroundColor #FFFDE7
skinparam classBorderColor #D84315
skinparam ArrowColor #333333
skinparam enumBackgroundColor #E3F2FD
skinparam enumBorderColor #1565C0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

title Diagramme de Classes — Finance RAG Project

' ═══════════════════════════════════════
'              ENUMS
' ═══════════════════════════════════════

enum UserRole {
  ADMIN
  FINANCE_USER
}

enum ReclamationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReclamationStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  FAILED
}

enum DocumentCategory {
  finance
  notes
  conventions
  recueil
  other
}

enum DocumentStatus {
  processing
  indexed
  failed
}

enum LegalStatus {
  actif
  futur
  remplace
  abroge
}

enum LegalDocumentType {
  loi
  decret
  arrete
  note
  circulaire
  autre
}

enum LegalRelationType {
  none
  remplace
  abroge
}

' ═══════════════════════════════════════
'              CLASSES
' ═══════════════════════════════════════

class UserModel {
  + id : String [0..1]
  + nom : String
  + prenom : String
  + email : String
  + passwordHash : String
  + role : UserRole
  + telephone : String
  + avatarUrl : String
  + adresse : String
  + birthDate : String
  + direction : String
  + service : String
  + poste : String
  + matricule : String
  + bureau : String
  + manager : String
  + memberSince : String
  + preferredLanguage : String
  + preferredTheme : String
  + emailNotificationsOn : Boolean
  + smsNotificationsOn : Boolean
  + isTwoFactorEnabled : Boolean
  + passwordChangedAt : DateTime
  + createdAt : DateTime
  + deletedAt : DateTime [0..1]
  --
  + from_mongo(raw) : UserModel
  + to_mongo_insert() : dict
  + to_public_dict() : dict
}

class SessionModel {
  + id : String [0..1]
  + userId : String
  + hashedToken : String
  + csrfToken : String
  + authMethod : String
  + ssoSubject : String [0..1]
  + ssoAccessToken : String [0..1]
  + ssoRefreshToken : String [0..1]
  + accessExpiresAt : DateTime
  + refreshExpiresAt : DateTime
  + idleExpiresAt : DateTime
  + absoluteExpiresAt : DateTime
  + createdAt : DateTime
  + lastActivityAt : DateTime
  + closedAt : DateTime [0..1]
  + closureReason : String [0..1]
  + isEarlyClosure : Boolean [0..1]
  --
  + from_mongo(raw) : SessionModel
  + to_mongo_insert() : dict
}

class NotificationModel {
  + id : String [0..1]
  + userId : String
  + notificationType : String
  + title : String
  + description : String
  + link : String [0..1]
  + isRead : Boolean
  + createdAt : DateTime
  + readAt : DateTime [0..1]
  --
  + from_mongo(raw) : NotificationModel
  + to_mongo_insert() : dict
}

class ReclamationModel {
  + id : String [0..1]
  + userId : String
  + userEmail : String
  + referenceNumber : String
  + subject : String
  + description : String
  + issueCategory : String
  + customIssueCategory : String [0..1]
  + priority : ReclamationPriority
  + status : ReclamationStatus
  + attachmentName : String [0..1]
  + attachmentPath : String [0..1]
  + attachmentSize : Integer [0..1]
  + attachmentContentType : String [0..1]
  + adminReply : String [0..1]
  + adminReplyAt : DateTime [0..1]
  + repliedByAdminId : String [0..1]
  + lastAdminActionAt : DateTime [0..1]
  + lastAdminActorName : String [0..1]
  + takenByAdminId : String [0..1]
  + takenByAdminName : String [0..1]
  + replyAcknowledged : Boolean
  + firstHandledAt : DateTime [0..1]
  + slaOverdueNotifiedAt : DateTime [0..1]
  + createdAt : DateTime
  + updatedAt : DateTime
  + deletedAt : DateTime [0..1]
  + deletedByUserId : String [0..1]
  + history : List<HistoryEntry>
  --
  + from_mongo(raw) : ReclamationModel
  + to_mongo_insert() : dict
}

class ConversationModel {
  + id : String [0..1]
  + userId : String
  + title : String
  + isArchived : Boolean
  + createdAt : DateTime
  + updatedAt : DateTime
  + archivedAt : DateTime [0..1]
  + deletedAt : DateTime [0..1]
  --
  + from_mongo(raw) : ConversationModel
  + to_mongo_insert() : dict
}

class ChatMessageModel {
  + id : String [0..1]
  + conversationId : String
  + role : String
  + content : String
  + status : String
  + sources : List<Source>
  + feedback : String [0..1]
  + feedbackAt : DateTime [0..1]
  + feedbackUserId : String [0..1]
  + createdAt : DateTime
  --
  + from_mongo(raw) : ChatMessageModel
  + to_mongo_insert() : dict
}

class DocumentModel {
  + id : String [0..1]
  + title : String
  + category : DocumentCategory
  + status : DocumentStatus
  + legalStatus : LegalStatus
  + legalType : LegalDocumentType
  + issuedAt : DateTime [0..1]
  + datePublication : DateTime [0..1]
  + dateEntreeVigueur : DateTime [0..1]
  + relationToTarget : LegalRelationType
  + targetDocumentId : String [0..1]
  + filePath : String
  + fileSize : Integer
  + fileType : String
  + description : String
  + extractedText : String [0..1]
  + indexedByAdminId : String [0..1]
  + deletedByAdminId : String [0..1]
  + createdAt : DateTime
  + deletedAt : DateTime [0..1]
  + indexedAt : DateTime [0..1]
  + chunkCount : Integer [0..1]
  + lastIndexError : String [0..1]
  --
  + from_mongo(raw) : DocumentModel
  + to_mongo_insert() : dict
  + to_out_schema() : DocumentOut
  + to_preview_schema() : DocumentPreviewOut
}

class AuditEventModel {
  + id : String [0..1]
  + occurredAt : DateTime
  + userId : String
  + userName : String
  + userEmail : String
  + userRole : String
  + actionType : String
  + actionLabel : String
  + category : String
  + entityType : String
  + entityId : String
  + entityLabel : String
  + summary : String
  + metadata : dict
  --
  + log_event() : void
  + list_recent() : list
  + list_filtered() : list
}

class DocumentFavoriteModel {
  + id : String [0..1]
  + documentId : String
  + userId : String
  + favoritedAt : DateTime
  --
  + from_mongo(raw) : DocumentFavoriteModel
  + to_mongo_insert() : dict
}

' ═══════════════════════════════════════
'              RELATIONS
'  Règle : association = ID stocké dans un champ
' ═══════════════════════════════════════

AuditEventModel   "0..*" --> "1"    UserModel         : userId >
SessionModel      "0..*" --> "1"    UserModel         : userId >
NotificationModel "0..*" --> "1"    UserModel         : userId >
ReclamationModel  "0..*" --> "1"    UserModel         : userId >
ConversationModel "0..*" --> "1"    UserModel         : userId >
ChatMessageModel  "1..*" --> "1"    ConversationModel : conversationId >
DocumentModel     "0..*" --> "0..1" DocumentModel     : targetDocumentId >

' Relation many-to-many avec classe d'association
UserModel     "1" --- "0..*" DocumentModel
(UserModel, DocumentModel) .. DocumentFavoriteModel

' ═══════════════════════════════════════
'         USAGES DES ENUMS
' ═══════════════════════════════════════

UserModel         ..> UserRole
ReclamationModel  ..> ReclamationPriority
ReclamationModel  ..> ReclamationStatus
DocumentModel     ..> DocumentCategory
DocumentModel     ..> DocumentStatus
DocumentModel     ..> LegalStatus
DocumentModel     ..> LegalDocumentType
DocumentModel     ..> LegalRelationType

@enduml
