@startuml dss_creer_reclamation

title Diagramme de Séquence Système : Créer une Réclamation

skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam defaultFontColor #000000
skinparam maxmessagesize 200
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 0
skinparam backgroundColor #FFFFFF

skinparam title {
    FontColor #000000
    FontStyle bold
    FontSize  14
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontColor       #000000
    FontStyle       bold
    FontSize        12
}
skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    BorderThickness 2
    FontColor       #000000
    FontStyle       bold
    FontSize        12
}
skinparam sequence {
    ArrowColor                #000000
    ArrowFontColor            #000000
    ArrowFontSize             10
    LifeLineBorderColor       #000000
    LifeLineBorderThickness   1
    LifeLineBackgroundColor   #FFFFFF
    ActivationBorderColor     #000000
    ActivationBackgroundColor #CCCCCC
    GroupBackgroundColor      #FFFFFF
    GroupBorderColor          #000000
    GroupBorderThickness      1.5
    GroupFontColor            #000000
    GroupFontStyle            plain
    GroupFontSize             10
    GroupHeaderFontColor      #000000
    GroupHeaderFontStyle      plain
    NoteBackgroundColor       #F5F5F5
    NoteBorderColor           #000000
    NoteFontColor             #000000
    NoteFontSize              10
}

actor "Agent" as agent
participant "Le Système" as sys

agent -> sys : ouvrirFormulaireReclamation()
activate sys
sys --> agent : afficher formulaire vide\n(sujet, description, catégorie, priorité, pièce jointe)
deactivate sys

agent -> sys : créerReclamation(sujet, description,\ncatégorie, priorité, piéceJointe?)
activate sys

note right of sys
  Normalisation des champs
  puis validation séquentielle
end note

alt sujet < 3 caractères
    sys --> agent : afficher erreur : ("sujet trop court")
else sujet > 160 caractères
    sys --> agent : afficher erreur : ("sujet trop long")
else description < 10 caractères
    sys --> agent : afficher erreur : ("description trop courte")
else description > 3000 caractères
    sys --> agent : afficher erreur : ("description trop longue")
else catégorie invalide
    sys --> agent : afficher erreur : ("type de problème invalide")
else catégorie = AUTRE sans précision
    sys --> agent : afficher erreur : ("veuillez préciser le type de problème")
else priorité invalide
    sys --> agent : afficher erreur : ("priorité invalide")
else format pièce jointe non autorisé
    note right of sys
      Formats acceptés :
      PDF, PNG, JPG, JPEG, DOC, DOCX
    end note
    sys --> agent : afficher erreur : ("format de pièce jointe non supporté")
else pièce jointe > 5 Mo
    sys --> agent : afficher erreur : ("pièce jointe dépasse 5 Mo")
else tous les champs valides
    sys --> agent : confirmer ("création de la réclamation")
end

deactivate sys

@enduml
